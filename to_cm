#! /bin/bash

#
# Marc Groenewegen, © 2013
#

if [ $# -lt 1 ]; then
  echo "Converts numbers to other units"
  echo
  echo "Supported conversions:"
  echo "to_inches <centimeters>"
  echo "to_cm <inches>"
  echo "to_celcius <fahrenheit>"
  echo "to_fahrenheit <celcius>"
  echo
  echo "Duims maat 	Buitendraad 	Binnendraad"
  echo "⅛ 		9.7 mm 		8.6 mm"
  echo "¼ 		13.2 mm 	11.4 mm"
  echo "⅜ 		16.7 mm 	14.9 mm"
  echo "½ 		21 mm 		18.6 mm"
  echo "¾ 		26.4 mm 	24.1 mm"
  echo "1 		33.2 mm 	30.3 mm"
  echo "1 ¼ 		41.9 mm 	39 mm"
  echo "1 ½ 		47.8 mm 	44.8 mm"
  echo "2 		59.6 mm 	56.7 mm"
  exit
fi

case `basename $0` in
  "to_inches")
    CONVERSION="$1/2.54"
  ;;
  "to_cm")
    CONVERSION="$1*2.54"
  ;;
  "to_celcius")
    CONVERSION="($1-32)*5/9"
  ;;
  "to_fahrenheit")
    CONVERSION="$1*9/5+32"
  ;;
esac

bc << EOF
scale=4
${CONVERSION}
quit
EOF

