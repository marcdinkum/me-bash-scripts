BASENAME=example
NROFPAGES=9

echo "Paste the output into a terminal to perform the merge"

echo gs -sDEVICE=pdfwrite -q -dNOPAUSE -dBATCH -dSAFER \
   -sOutputFile=merged.pdf "\\"

for filenumber in `seq 1 $NROFPAGES`;
do
  numberstring=`printf %04d $filenumber`
  echo -n "${BASENAME}_${numberstring}.pdf "
done

